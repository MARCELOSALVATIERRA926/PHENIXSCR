# Borramos todo lo que está mal
rm -f fenix-instalador

# Creamos el archivo DESDE CERO, EXACTO, SIN ERRORES
cat > fenix-instalador << 'FIN'
#!/bin/bash

N="\033[0m"
B="\033[1;37m"
A="\033[1;33m"
