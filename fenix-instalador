M="\033[1;35m"

clear

echo -e "
${C}═══════════════════════════════════════════════════════════${N}
${A}        FENIX-SCR — INICIANDO${N}
${B}        Fenix 3815569765${N}
${C}═══════════════════════════════════════════════════════════${N}
"

mkdir -p /etc/FENIX-SCR/modulos

cat > /etc/FENIX-SCR/modulos/m2protocolos.sh << 'MOD'
#!/bin/bash
N="\033[0m"; B="\033[1;37m"; A="\033[1;33m"; V="\033[1;32m"
R="\033[1;31m"; C="\033[1;36m"; Az="\033[1;34m"; M="\033[1;35m"

SSH_ON=true; DROPBEAR_ON=true; SOCKS_ON=true
STUNNEL_ON=false; SLOWDNS_ON=false; WSEPRO_ON=false
UDP_CUSTOM_ON=false; UDP_HYSTERIA_ON=false; BADVPN_ON=false
SQUID_ON=false; OPENVPN_ON=false; CHECKUSER_ON=false
ATKEN_ON=false; FILEBROWSER_ON=false; V2RAY_ON=false
SSHGO_ON=false; WIREGUARD_ON=false; HCRM_ON=false

estado() { [ "$1" = true ] && echo -e "${V}[ON]${N}" || echo -e "${R}[OFF]${N}"; }

while true; do
  clear
  echo -e "
${C}════════════════════════════════════════════════════════════${N}
${M}                      Fenix 3815569765${N}
${C}════════════════════════════════════════════════════════════${N}
${B}                ADMINISTRADOR DE PROTOCOLOS${N}
${C}════════════════════════════════════════════════════════════${N}
  ${V}DROPBEAR:${N} 90                  ${V}PYTHON3:${N} 80
  ${V}SSH:${N} 22
${C}════════════════════════════════════════════════════════════${N}
  ${A}[1]${N}> AJUSTES SSH       $(estado $SSH_ON)        ${A}[10]${N}> SQUID             $(estado $SQUID_ON)
  ${A}[2]${N}> DROPBEAR          $(estado $DROPBEAR_ON)        ${A}[11]${N}> OPENVPN           $(estado $OPENVPN_ON)
  ${A}[3]${N}> SOCKS PYTHON      $(estado $SOCKS_ON)        ${A}[12]${N}> CHECKUSER ONLINE  $(estado $CHECKUSER_ON)
  ${A}[4]${N}> STUNNEL (SSL)     $(estado $STUNNEL_ON)       ${A}[13]${N}> ATKEN and HASH    $(estado $ATKEN_ON)
  ${A}[5]${N}> SLOWDNS           $(estado $SLOWDNS_ON)       ${A}[14]${N}> FILEBROWSER       $(estado $FILEBROWSER_ON)
  ${A}[6]${N}> WS-EPRO           $(estado $WSEPRO_ON)        ${A}[15]${N}> V2RAY/XRAY        $(estado $V2RAY_ON)
  ${A}[7]${N}> UDP-CUSTOM        $(estado $UDP_CUSTOM_ON)     ${A}[16]${N}> SSHGO             $(estado $SSHGO_ON)
  ${A}[8]${N}> UDP-HYSTERIA      $(estado $UDP_HYSTERIA_ON)   ${A}[17]${N}> WIREGUARD         $(estado $WIREGUARD_ON)
  ${A}[9]${N}> BADVPN-UDPGW      $(estado $BADVPN_ON)
 ${A}[18]${N}> HCRM              $(estado $HCRM_ON)
${C}════════════════════════════════════════════════════════════${N}
  ${V}[0]${N} Volver al menú
${C}════════════════════════════════════════════════════════════${N}
 ${B}Ingresá una opción: ${N}\c"
  read op
  case "$op" in
    0) exit 0 ;;
    *) echo -e "\n${R}❌ Opción inválida${N}"; sleep 1; continue ;;
  esac
done
MOD

chmod +x /etc/FENIX-SCR/modulos/m2protocolos.sh
echo -e "\n${V}✅ Instalación terminada${N}"
FIN

chmod +x fenix-instalador
./fenix-instalador
